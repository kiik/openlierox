# OpenLieroX dedicated-server configuration.
#
# Copy this file to docker/.env and edit it; docker compose reads it
# automatically. Every variable is optional -- leave one blank (or delete the
# line) to keep the server's packaged default. See docker/README.md for the
# full reference.
#
#   cp docker/.env.example docker/.env

# Server name shown in the in-game server browser.
OLX_SERVER_NAME=My OLX Server

# UDP game port. This is both the in-container port and the published host
# port (docker-compose.yml publishes ${OLX_PORT}:${OLX_PORT}/udp), so set it
# here only. Publish the same port on your router/firewall for a public server.
OLX_PORT=23400

# Maximum players (1-32).
OLX_MAX_PLAYERS=14

# Players needed before a round starts.
OLX_MIN_PLAYERS=1

# Comma-separated preset cycle, e.g. Mortars,Random,CTF. Blank = stock cycle.
# Presets are the directories under share/gamedir/scripts/presets/.
OLX_PRESET=

# 1 lists the server on the master server (in-game browser); 0 keeps it
# unlisted so clients join by entering the host address directly.
OLX_REGISTER_SERVER=1

# Message shown to joining players. <server> and <player> are substituted.
OLX_WELCOME_MESSAGE=

# If set, a player who types "/login <password>" in chat becomes a server
# admin (map/preset control, kick, voting). Blank disables /login.
OLX_ADMIN_PASSWORD=

# Build-only: version string baked into the binary when building via compose.
# Leave as-is unless you are producing a release build.
OLX_VERSION=0.0-docker
